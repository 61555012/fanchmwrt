From: OpenWrt FullCone integration
Subject: [PATCH] firewall4: add global FullCone NAT switch

Add a single defaults.fullcone switch. When enabled and supported by the
installed nftables stack, replace IPv4 and IPv6 masquerading with FullCone
NAT for every zone using masq or masq6.

Install FullCone rules in both the destination and source NAT paths. Keep
masq_src and masq_dest restrictions on source NAT rules so enabling
FullCone does not broaden the set of outgoing traffic subject to NAT.

Probe the nftables expression before generating rules and fall back to
masquerade when it is unavailable.

Based on the ImmortalWrt implementation and rebased onto firewall4 commit
b6e5157527d361f99ad52eaa6da273cb0f2dfd59 used by OpenWrt v25.12.4.

---
 root/etc/config/firewall                           |  1 +
 root/usr/share/firewall4/templates/ruleset.uc      | 10 ++++++--
 .../usr/share/firewall4/templates/zone-fullcone.uc | 13 ++++++++++
 root/usr/share/ucode/fw4.uc                        | 30 +++++++++++++++++++++-
 4 files changed, 51 insertions(+), 3 deletions(-)
 create mode 100644 root/usr/share/firewall4/templates/zone-fullcone.uc

diff --git a/root/etc/config/firewall b/root/etc/config/firewall
index 48b2440..9fdbb37 100644
--- a/root/etc/config/firewall
+++ b/root/etc/config/firewall
@@ -3,6 +3,7 @@ config defaults
 	option input		REJECT
 	option output		ACCEPT
 	option forward		REJECT
+	option fullcone		0
 # Uncomment this line to disable ipv6 rules
 #	option disable_ipv6	1
 
diff --git a/root/usr/share/firewall4/templates/ruleset.uc b/root/usr/share/firewall4/templates/ruleset.uc
index 2bec4d9..50ea8d4 100644
--- a/root/usr/share/firewall4/templates/ruleset.uc
+++ b/root/usr/share/firewall4/templates/ruleset.uc
@@ -327,6 +327,12 @@ table inet fw4 {
 {%   for (let redirect in fw4.redirects(`dstnat_${zone.name}`)): %}
 		{%+ include("redirect.uc", { fw4, zone, redirect }) %}
 {%   endfor %}
+{%   if (fw4.default_option("fullcone") && zone.masq): %}
+		{%+ include("zone-fullcone.uc", { fw4, zone, family: 4, direction: "dstnat", saddrs: null, daddrs: null }) %}
+{%   endif %}
+{%   if (fw4.default_option("fullcone") && zone.masq6): %}
+		{%+ include("zone-fullcone.uc", { fw4, zone, family: 6, direction: "dstnat", saddrs: null, daddrs: null }) %}
+{%   endif %}
 {%   fw4.includes('chain-append', `dstnat_${zone.name}`) %}
 	}
 
@@ -340,14 +346,14 @@ table inet fw4 {
 {%   if (zone.masq): %}
 {%    for (let saddrs in zone.masq4_src_subnets): %}
 {%     for (let daddrs in zone.masq4_dest_subnets): %}
-		{%+ include("zone-masq.uc", { fw4, zone, family: 4, saddrs, daddrs }) %}
+		{%+ include(fw4.default_option("fullcone") ? "zone-fullcone.uc" : "zone-masq.uc", { fw4, zone, family: 4, direction: "srcnat", saddrs, daddrs }) %}
 {%     endfor %}
 {%    endfor %}
 {%   endif %}
 {%   if (zone.masq6): %}
 {%    for (let saddrs in zone.masq6_src_subnets): %}
 {%     for (let daddrs in zone.masq6_dest_subnets): %}
-		{%+ include("zone-masq.uc", { fw4, zone, family: 6, saddrs, daddrs }) %}
+		{%+ include(fw4.default_option("fullcone") ? "zone-fullcone.uc" : "zone-masq.uc", { fw4, zone, family: 6, direction: "srcnat", saddrs, daddrs }) %}
 {%     endfor %}
 {%    endfor %}
 {%   endif %}
diff --git a/root/usr/share/firewall4/templates/zone-fullcone.uc b/root/usr/share/firewall4/templates/zone-fullcone.uc
new file mode 100644
index 0000000..abee39c
--- /dev/null
+++ b/root/usr/share/firewall4/templates/zone-fullcone.uc
@@ -0,0 +1,13 @@
+meta nfproto {{ fw4.nfproto(family) }} {%+ if (saddrs && saddrs[0]): -%}
+	{{ fw4.ipproto(family) }} saddr {{ fw4.set(map(saddrs[0], fw4.cidr)) }} {%+ endif -%}
+{%+ if (saddrs && saddrs[1]): -%}
+	{{ fw4.ipproto(family) }} saddr != {{ fw4.set(map(saddrs[1], fw4.cidr)) }} {%+ endif -%}
+{%+ for (let a in (saddrs ? saddrs[2] : [])): -%}
+	{{ fw4.ipproto(family) }} saddr & {{ a.mask }} {{ a.invert ? '!=' : '==' }} {{ a.addr }} {%+ endfor -%}
+{%+ if (daddrs && daddrs[0]): -%}
+	{{ fw4.ipproto(family) }} daddr {{ fw4.set(map(daddrs[0], fw4.cidr)) }} {%+ endif -%}
+{%+ if (daddrs && daddrs[1]): -%}
+	{{ fw4.ipproto(family) }} daddr != {{ fw4.set(map(daddrs[1], fw4.cidr)) }} {%+ endif -%}
+{%+ for (let a in (daddrs ? daddrs[2] : [])): -%}
+	{{ fw4.ipproto(family) }} daddr & {{ a.mask }} {{ a.invert ? '!=' : '==' }} {{ a.addr }} {%+ endfor -%}
+fullcone comment "!fw4: FullCone NAT {{ direction }} {{ fw4.nfproto(family, true) }} {{ zone.name }} traffic"
diff --git a/root/usr/share/ucode/fw4.uc b/root/usr/share/ucode/fw4.uc
index 690deb0..421df35 100644
--- a/root/usr/share/ucode/fw4.uc
+++ b/root/usr/share/ucode/fw4.uc
@@ -489,6 +489,24 @@ function nft_try_hw_offload(devices) {
 	return (rc == 0);
 }
 
+function nft_try_fullcone() {
+	let nft_test = `
+		add table inet fw4-fullcone-test;
+		add chain inet fw4-fullcone-test dstnat {
+			type nat hook prerouting priority dstnat; policy accept;
+			fullcone;
+		}
+		add chain inet fw4-fullcone-test srcnat {
+			type nat hook postrouting priority srcnat; policy accept;
+			fullcone;
+		}
+	`;
+
+	let rc = system(`/usr/sbin/nft -c '${replace(nft_test, "'", "'\\''")}' 2>/dev/null`);
+
+	return (rc == 0);
+}
+
 
 return {
 	read_kernel_version: function() {
@@ -1946,6 +1964,7 @@ return {
 		}
 
 		let defs = this.parse_options(data, {
+			fullcone: [ "bool", "0" ],
 			input: [ "policy", "drop" ],
 			output: [ "policy", "drop" ],
 			forward: [ "policy", "drop" ],
@@ -1980,6 +1999,11 @@ return {
 
 		delete defs.syn_flood;
 
+		if (defs.fullcone && !nft_try_fullcone()) {
+			defs.fullcone = false;
+			warn("FullCone NAT is enabled but the nftables fullcone expression is unavailable; falling back to masquerade\n");
+		}
+
 		this.state.defaults = defs;
 	},
 
@@ -2205,9 +2229,13 @@ return {
 		zone.related_subnets = related_subnets;
 		zone.related_physdevs = related_physdevs;
 
-		if (zone.masq || zone.masq6)
+		if (zone.masq || zone.masq6) {
 			zone.dflags.snat = true;
 
+			if (this.state.defaults.fullcone)
+				zone.dflags.dnat = true;
+		}
+
 		if ((zone.auto_helper && !(zone.masq || zone.masq6)) || length(zone.helper)) {
 			zone.dflags.helper = true;
 
-- 
2.49.0
