#!/bin/sh /etc/rc.common

START=96
STOP=10
USE_PROCD=1

start_service() {
	# 账本目录（今日累计 + 历史）在 flash 上，重装/重启不丢
	mkdir -p /etc/client-rates

	procd_open_instance
	procd_set_param command /usr/bin/ucode /usr/share/client-rates/sampler.uc
	procd_set_param respawn 3600 5 5
	procd_set_param limits core="0"
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger "turboacc"
}
